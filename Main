<script>

function wetBulbTemp(T, RH){

let rh = RH;

let twb =
T * Math.atan(0.151977 * Math.sqrt(rh + 8.313659)) +
Math.atan(T + rh) -
Math.atan(rh - 1.676331) +
0.00391838 * Math.pow(rh, 1.5) * Math.atan(0.023101 * rh) -
4.686035;

return twb;

}

function calcIECTemp(Tdb, Twb, efficiency){

return Tdb - efficiency * (Tdb - Twb);

}

function calcAirflow(loadKW, returnTemp, supplyTemp){

let rho = 1.2;
let cp = 1005;

let Q = loadKW * 1000;

let deltaT = returnTemp - supplyTemp;

return Q / (rho * cp * deltaT);

}

function calcWaterUse(loadKW){

let latent = 2450000;

let kgps = (loadKW * 1000) / latent;

return kgps * 3600 / 1000;

}

function calcPUE(itLoad, airflow){

let fanPower = airflow * 0.8;

let coolingPower = fanPower;

return (itLoad + coolingPower) / itLoad;

}

function runCalculation(){

let racks = parseFloat(document.getElementById("rackNumber").value);

let rackPower = parseFloat(document.getElementById("rackPower").value);

let returnTemp = parseFloat(document.getElementById("returnTemp").value);

let Tdb = parseFloat(document.getElementById("dryBulb").value);

let RH = parseFloat(document.getElementById("humidity").value);

let efficiency = parseFloat(document.getElementById("efficiency").value);

let itLoad = racks * rackPower;

let Twb = wetBulbTemp(Tdb, RH);

let supplyTemp = calcIECTemp(Tdb, Twb, efficiency);

let airflow = calcAirflow(itLoad, returnTemp, supplyTemp);

let water = calcWaterUse(itLoad);

let pue = calcPUE(itLoad, airflow);

document.getElementById("itLoad").innerText = itLoad.toFixed(1);

document.getElementById("wetBulb").innerText = Twb.toFixed(1);

document.getElementById("supplyTemp").innerText = supplyTemp.toFixed(1);

document.getElementById("airflow").innerText = airflow.toFixed(1);

document.getElementById("waterUse").innerText = water.toFixed(2);

document.getElementById("pue").innerText = pue.toFixed(2);

}

</script>

